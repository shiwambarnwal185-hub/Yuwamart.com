# Copy this file to ".env" and fill in your real values.

# Port the server runs on
PORT=3000

# Password for the Owner Dashboard (CHANGE THIS in a shared/public repo)
ADMIN_PASSWORD=yur@2020

# Delivery service area: Birgunj + Pakaha Mainpur Municipality (Parsa District)
# Radius in kilometers from each area's center that the app will accept orders from
BIRGUNJ_RADIUS_KM=14
PAKAHA_MAINPUR_RADIUS_KM=6

# Minimum order amount in NPR
MIN_ORDER_AMOUNT=100

# --- SMS OTP (optional but recommended for a real launch) ---
# Sign up at https://sparrowsms.com (Nepal SMS gateway), buy an SMS package,
# and paste your token below. Without this, OTPs are only shown on-screen
# in the app (no real SMS is sent) — the app still works fine for testing.
SPARROW_TOKEN=
SPARROW_FROM=YuwaMart
